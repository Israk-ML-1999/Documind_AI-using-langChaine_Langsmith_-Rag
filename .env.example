# ==========================================
# DocuMind AI - Production Environment Variables
# ==========================================

# Google Gemini API Key (Required for AI chat & embeddings)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# PostgreSQL Database Credentials
POSTGRES_USER=documind
POSTGRES_PASSWORD=documindpassword
POSTGRES_DB=documind

# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_key_here

# Allowed Origins for CORS (Comma separated, or * for all)
ALLOWED_ORIGINS=*

# Frontend API URL
# Leave blank ("") if using Nginx reverse proxy (/api/v1)
# Or set to http://<YOUR_VPS_IP>:8000/api/v1 if running directly without Nginx
NEXT_PUBLIC_API_URL=

# Redis Connection URL
REDIS_URL=redis://redis:6379/0

# PgAdmin Credentials (Optional Database Management UI)
PGADMIN_EMAIL=admin@documind.com
PGADMIN_PASSWORD=admin

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=documind

